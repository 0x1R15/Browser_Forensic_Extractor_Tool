{
  "manifest_version": 3,
  "name": "Forensic Browser Extractor",
  "short_name": "FBEx",
  "version": "1.0.0",
  "description": "Forensic-grade browser evidence capture: tamper-evident activity logging, timeline analysis, anomaly detection, and case reporting.",
  "author": "Browser Forensics Toolkit",
  "minimum_chrome_version": "116",
  "permissions": [
    "history",
    "downloads",
    "cookies",
    "tabs",
    "webNavigation",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Forensic Browser Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "dashboard/dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
